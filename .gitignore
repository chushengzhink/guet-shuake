# 会话 / 账号 / 状态 —— 绝不入库
profiles/
data/
config.yaml
accounts.yaml
cookies*.json
storage_state*.json

# 抓包原件（几十 MB）
*.har
*.har.gz

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
