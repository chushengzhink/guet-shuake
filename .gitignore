.mypy_cache/
.ruff_cache/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini

# 构建产物（不进仓库）
dist/
build/
packaging/output/
packaging/browsers/
*.log

# 签名私钥（绝不入库）
# 私钥不入库；公钥证书 .cer 保留，用户可导入以信任自签名
packaging/certs/*.pfx
*.pfx
